<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body>
    <div class="main-container">
      <div id="main-heading">
        <h1><%= title %></h1>
        <hr />
      </div>
      <div class="main-image">
        <img src="/images/stacked_books.png" />
      </div>

      <div id="booksList">
        <% if (books.length) { %>
        <ul>
          <% books.forEach(function(book) { %>
          <li id="book-items"><%= book.title %> by <%= book.author %></li>
          <% }); %>
        </ul>
        <% } else { %>
        <p>No books found for the specified author.</p>
        <% } %>
      </div>
      <div class="main-button-container">
        <a id="return-home" href="/">Go back to home</a>
      </div>
    </div>
    <script src="\javascripts\scripts.js"></script>
  </body>
</html>
